{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "scan": "tsx --env-file-if-exists=../.env src/cli.ts",
    "typecheck": "tsc -p .",
    "postinstall": "node -e \"process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD || require('child_process').execSync('playwright install chromium', { stdio: 'inherit' })\""
  },
  "dependencies": {
    "@a11y/shared": "*",
    "@axe-core/playwright": "^4.13.0",
    "@supabase/supabase-js": "^2.117.2",
    "chrome-launcher": "^1.2.2",
    "fast-xml-parser": "^5.11.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "robots-parser": "^3.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
